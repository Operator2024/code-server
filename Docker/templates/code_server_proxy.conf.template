http {
    proxy_buffers 48 16k;
    proxy_buffer_size 16k;
    proxy_busy_buffers_size 24k;

    server {
        access_log /var/log/nginx/access.log combined;
        listen       80;
        server_name $NGINX_DOMAIN;

        location /natasha/ {
            proxy_pass http://code-server:8443/;
            # proxy_set_header X-Real-IP $remote_addr;
            # proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Host $host;
            # proxy_set_header X-NginX-Proxy true;
            # proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Accept-Encoding gzip;
            # proxy_redirect off;
            add_header X-debug-message "$http_upgrade $host $remote_addr $proxy_add_x_forwarded_for $1" always;
        }

        # redirect server error pages to the static page /50x.html
        #
        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   /usr/share/nginx/html;
        }
    }

    server {
        access_log /var/log/nginx/access.log combined;
        listen       80;
        server_name  ~^(3000|5500|5501)\.$NGINX_DOMAIN$;

        # ^(3000|5500)\.code-server\.operator2018\.ru$

        location / {
            # proxy_pass http://code-server:8443/natasha/proxy/$1/;
            resolver 127.0.0.11 valid=10s;
            resolver_timeout 5s;
            proxy_pass http://code-server:$1/;
            proxy_set_header X-Real-IP $remote_addr;
            # proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Host $host;
            proxy_set_header X-NginX-Proxy true;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Accept-Encoding gzip;
            # proxy_redirect off;
            add_header X-debug-message "$http_upgrade $host $remote_addr $proxy_add_x_forwarded_for $1 $http_cookie" always;
        }
    }
}