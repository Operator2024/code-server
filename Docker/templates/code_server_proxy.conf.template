http {
    server_tokens off;
    proxy_buffers 48 16k;
    proxy_buffer_size 16k;
    proxy_busy_buffers_size 24k;

    proxy_cache_path /tmp/cache levels=1:2 keys_zone=cache:60m max_size=1G use_temp_path=off;
    proxy_cache_methods GET HEAD;

    proxy_redirect     off;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $remote_addr;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   Host $host;
    proxy_set_header   Connection "";

    map $http_upgrade $connection_upgrade {
     default     upgrade;
     ''          close;
    }

    server {
        access_log /var/log/nginx/access.log combined;
        listen       80;
        server_name $NGINX_DOMAIN;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$NGINX_DOMAIN$request_uri;
        }
    }

    server {
        access_log /var/log/nginx/access.log combined;
        listen       443 ssl;
        http2        on;
        server_name $NGINX_DOMAIN;

        ssl_certificate /etc/nginx/ssl/live/$NGINX_DOMAIN/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/live/$NGINX_DOMAIN/privkey.pem;

        location = / {
            return 444;
        }

        location $NGINX_LOCATION {

            if ($http_cookie !~* ^code-server-session\=){
                set $bypass no_cookie;
            }

            #if ($sent_http_location ~ ^\.\/(login|logout)){
            #    set $bypass 1;
            #}

            if ($http_referer ~ \/(login|logout)) {
                set $bypass no_cache_auth;
            }

            proxy_pass http://code-server:$VS_PORT/;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Accept-Encoding gzip;
            proxy_set_header   Host $host;
            proxy_set_header   X-NginX-Proxy true;
            proxy_http_version 1.1;

            proxy_cache          cache;
            proxy_cache_key      $host$uri$is_args$args;
            proxy_cache_valid    200 301 302 30m;
            proxy_cache_valid    404         10m;
            proxy_cache_bypass   $bypass;

            # expires              10m;

            # Debug
            #add_header X-debug-message-2 "$sent_http_location, $http_location , $upstream_http_location";
            #add_header X-debug-message "$http_upgrade $connection_upgrade $host $remote_addr $proxy_add_x_forwarded_for $1 $uri t2 $args, cookie: $cookie_code_server_session, $bypass $sent_http_location" always;
        }

        # redirect server error pages to the static page /50x.html
        #
        error_page   500 502 503 504  /50x.html;
    }

    server {
        access_log /var/log/nginx/access.log combined;
        listen       443 ssl;
        http2        on;

        server_name  ~^(3000|5500|5501)\.$NGINX_DOMAIN$;

        ssl_certificate /etc/nginx/ssl/live/$NGINX_DOMAIN/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/live/$NGINX_DOMAIN/privkey.pem;

        location / {
            resolver 127.0.0.11 valid=10s;
            resolver_timeout 5s;

            proxy_pass http://code-server:$1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Accept-Encoding gzip;
            proxy_redirect off;
            proxy_intercept_errors on;

            proxy_set_header   X-NginX-Proxy true;
            proxy_http_version 1.1;
            proxy_connect_timeout 15s;
            proxy_send_timeout 3600s; # ws will open for 1 hour
            proxy_read_timeout 3600s; # ws will open for 1 hour

            error_page 502 =200 @fallback;
            error_page 500 /50x.html;

            # add_header X-debug-message "$http_upgrade $connection_upgrade $host $remote_addr $proxy_add_x_forwarded_for $1 $http_cookie $uri" always;
        }
        location @fallback {
            root   /usr/share/nginx/html;
            try_files /index.html =404;
        }
        location = /50x.html {
            root   /usr/share/nginx/html;
        }
    }
}